---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyBackground from "../components/TopologyBackground.astro";
import Logo from "../components/Logo.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Icon from "../components/Icon.astro";
import SignUpForm from "../components/islands/SignUpForm";

// Desktop app callback support: if the desktop app navigates here with ?desktop_callback=...,
// the sign-up will redirect back to that callback URL with the auth token.
// This is passed to the form via URL params.
const desktopCallback = Astro.url.searchParams.get('desktop_callback');
---

<BaseLayout title="Create account | Obrenna">
  <main class="auth-page" data-desktop-callback={desktopCallback || undefined}>
    <TopologyBackground />
    <div class="auth-brand"><Logo /></div>
    <div class="auth-copy">
      <Eyebrow>ORGANIZATION-OWNED AI</Eyebrow>
      <h1>Create your Obrenna account.</h1>
      <p>Start an organization or join one you've been invited to.</p>
      <div class="auth-architecture">
        <div><Icon name="cloud-cog" /><span><b>Obrenna control plane</b><small>Identity · policy · health</small></span></div>
        <span class="auth-line"><Icon name="lock-keyhole" size={16} /></span>
        <div><Icon name="server" /><span><b>Your private infrastructure</b><small>Models · tools · company data</small></span></div>
      </div>
    </div>
    <SignUpForm client:load desktopCallback={desktopCallback || undefined} />
  </main>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Logo from "../../components/Logo.astro";
import TopologyBackground from "../../components/TopologyBackground.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Icon from "../../components/Icon.astro";
import Status from "../../components/Status.astro";
import ConnectionCheckButton from "../../components/islands/ConnectionCheckButton";
import { routes } from "../../lib/routes";
import {
  getEmployeePortal,
  toConnectionStatus,
  confirmationTone,
  type EmployeePortalData,
} from "../../lib/api/employee";
import { getPortalAccount } from "../../lib/portal-account";

const account = await getPortalAccount(Astro.request);
if (!account) {
  return Astro.redirect(`/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

let portal: EmployeePortalData | null = null;
let loadError = "";
try {
  portal = await getEmployeePortal();
} catch (cause) {
  loadError = cause instanceof Error ? cause.message : "Could not load your organization access";
}

const connection = toConnectionStatus(portal, account.organization.name);

function timeAgo(iso: string) {
  const seconds = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
  if (seconds < 60) return "Just now";
  if (seconds < 3600) return `${Math.floor(seconds / 60)} min ago`;
  if (seconds < 86400) return `${Math.floor(seconds / 3600)} hr ago`;
  return `${Math.floor(seconds / 86400)} days ago`;
}
---

<BaseLayout title="Employee portal | Obrenna">
  <div class="employee-page">
    <header class="employee-header">
      <Logo />
      <nav>
        <a class="active">Home</a>
        <a>Models &amp; tools</a>
        <a>My approvals</a>
        <a>Sessions</a>
        <a href={routes.docs}>Help</a>
      </nav>
      <div class="employee-actions">
        <span class="employee-avatar" title={`${account.user.fullName} (${account.user.email})`}>{account.user.initials}</span>
      </div>
    </header>
    <main>
      <div class="employee-hero">
        <TopologyBackground />
        <div class="container employee-hero-inner">
          <div>
            <Eyebrow>{account.organization.name.toUpperCase()}</Eyebrow>
            <h1>Your organization access.</h1>
            <p>Approved models and tools are assigned to your role by your organization's policy configuration.</p>
            <div class="hero-actions">
              <a class="button button-ghost" href={routes.download}><Icon name="download" size={16} /> Download app</a>
            </div>
          </div>
          <div class="connection-card">
            <div>
              <span class="connection-icon"><Icon name="link-2" size={16} /></span>
              <span><small>CONNECTION STATUS</small><b>{account.organization.name}</b></span>
              <Status tone={connection.connected ? "good" : "neutral"}>{connection.connected ? "Connected" : "No machine online"}</Status>
            </div>
            <dl>
              <div><dt>Private machine</dt><dd>{connection.machineName}</dd></div>
              <div><dt>Available models</dt><dd>{connection.availableModelCount}</dd></div>
              <div><dt>Available tools</dt><dd>{connection.availableToolCount}</dd></div>
              <div><dt>Configuration</dt><dd>{connection.configVersion}</dd></div>
            </dl>
            <div class="privacy-line"><Icon name="shield-check" size={14} /> Your prompts and work stay inside {account.organization.name}.</div>
          </div>
        </div>
      </div>

      <section class="employee-content container">
        {loadError && <div class="admin-data-notice" role="status"><strong>Your organization access is unavailable.</strong><span>{loadError}</span></div>}

        {!loadError && portal && (
          <div class="employee-access-grid">
            <article>
              <div class="card-header"><div><h3>Available models</h3><p>Approved for your role</p></div></div>
              {
                portal.allocated_models.map((m) => (
                  <div class="employee-model">
                    <span class="model-orb"><Icon name="brain-circuit" size={18} /></span>
                    <span><b>{m.display_name}</b><small>{m.provider}</small></span>
                    <Status tone={m.status === "healthy" ? "good" : "warn"}>{m.status === "healthy" ? "Available" : "Check pending"}</Status>
                  </div>
                ))
              }
              {portal.allocated_models.length === 0 && <p role="status">No models have been allocated yet.</p>}
            </article>
            <article>
              <div class="card-header"><div><h3>Available tools</h3><p>{portal.allocated_tools.length} approved tools</p></div></div>
              {
                portal.allocated_tools.map((t) => (
                  <div class="tool-service-row">
                    <span><Icon name="network" size={15} /></span>
                    <span><b>{t.tool_name}</b><small>{t.risk}</small></span>
                    <em>{t.confirmation === "never" ? "No confirmation" : t.confirmation === "first_use" ? "First-use confirmation" : "Every use"}</em>
                  </div>
                ))
              }
              {portal.allocated_tools.length === 0 && <p role="status">No tools have been approved for your organization yet.</p>}
            </article>
          </div>
        )}

        <div class="employee-bottom-grid">
          <article class="employee-activity">
            <div class="card-header"><div><h3>Your recent confirmations</h3><p>Only you and authorized administrators can see this metadata.</p></div></div>
            {
              portal && portal.recent_confirmations.map((c) => (
                <div>
                  <Status tone={confirmationTone(c.event_type)}>{c.event_type.replaceAll("_", " ")}</Status>
                  <span><b>{c.summary || c.event_type}</b><small>{timeAgo(c.created_at)}</small></span>
                </div>
              ))
            }
            {portal && portal.recent_confirmations.length === 0 && <p role="status">No confirmations recorded for your account yet.</p>}
          </article>
          <article class="employee-help">
            <Icon name="life-buoy" size={20} />
            <span><b>Having trouble connecting?</b><p>Run the connection check or see organization-specific troubleshooting.</p></span>
            <ConnectionCheckButton client:load />
            <a href={routes.docs}>Get help <Icon name="arrow-right" size={13} /></a>
          </article>
        </div>
      </section>
    </main>
    <footer class="employee-footer">
      <span>{account.organization.name} · Signed in as {account.user.fullName} ({account.organization.role})</span>
      <div><a href="/privacy">Privacy</a><a href="/why-obrenna">Security</a></div>
    </footer>
  </div>
</BaseLayout>
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Logo from "../../components/Logo.astro";
import TopologyBackground from "../../components/TopologyBackground.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Icon from "../../components/Icon.astro";
import Status from "../../components/Status.astro";
import ConnectionCheckButton from "../../components/islands/ConnectionCheckButton";
import { routes } from "../../lib/routes";
import { getConnectionStatus, getAvailableModels, getAvailableToolServices, getMyRecentConfirmations } from "../../lib/api/employee";
import { getPortalAccount } from "../../lib/portal-account";

const account = await getPortalAccount(Astro.request);
if (!account) {
  return Astro.redirect(`/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const connection = await getConnectionStatus();
const models = await getAvailableModels();
const toolServices = await getAvailableToolServices();
const confirmations = await getMyRecentConfirmations();
---

<BaseLayout title="Employee portal | Obrenna">
  <div class="employee-page">
    <header class="employee-header">
      <Logo />
      <nav>
        <a class="active">Home</a>
        <a>Models & tools</a>
        <a>My approvals</a>
        <a>Sessions</a>
        <a href={routes.docs}>Help</a>
      </nav>
      <div class="employee-actions">
        <button><Icon name="circle-help" size={18} /></button>
        <span class="employee-avatar" title={`${account.user.fullName} (${account.user.email})`}>{account.user.initials}</span>
        <Icon name="chevron-down" size={14} />
      </div>
    </header>
    <main>
      <div class="employee-hero">
        <TopologyBackground />
        <div class="container employee-hero-inner">
          <div>
            <Eyebrow>{account.organization.name.toUpperCase()}</Eyebrow>
            <h1>Your private AI is ready.</h1>
            <p>Connect through Obrenna Desktop to use organization-approved models and internal tools.</p>
            <div class="hero-actions">
              <button class="button"><Icon name="laptop" size={16} /> Open Obrenna Desktop</button>
              <a class="button button-ghost" href={routes.download}><Icon name="download" size={16} /> Download app</a>
            </div>
          </div>
          <div class="connection-card">
            <div>
              <span class="connection-icon"><Icon name="link-2" size={16} /></span>
              <span><small>CONNECTION STATUS</small><b>{account.organization.name}</b></span>
              <Status>{connection.connected ? "Connected" : "Offline"}</Status>
            </div>
            <dl>
              <div><dt>Private machine</dt><dd>{connection.machineName}</dd></div>
              <div><dt>Available models</dt><dd>{connection.availableModelCount}</dd></div>
              <div><dt>Available tools</dt><dd>{connection.availableToolCount}</dd></div>
              <div><dt>Configuration</dt><dd>{connection.configVersion} · current</dd></div>
            </dl>
            <div class="privacy-line"><Icon name="shield-check" size={14} /> Your prompts and work stay inside {account.organization.name}.</div>
          </div>
        </div>
      </div>

      <section class="employee-content container">
        <div class="employee-heading">
          <div><h2>Your organization access</h2><p>Everything available to your Member role.</p></div>
          <span>Last updated just now <Icon name="refresh-ccw" size={13} /></span>
        </div>

        <div class="employee-access-grid">
          <article>
            <div class="card-header"><div><h3>Available models</h3><p>Approved for your role</p></div><a>View details<Icon name="arrow-right" size={13} /></a></div>
            {
              models.map((m) => (
                <div class="employee-model">
                  <span class={`model-orb ${m.variant === "alt" ? "alt" : ""}`}><Icon name={m.icon} size={18} /></span>
                  <span><b>{m.name}</b><small>{m.description}</small></span>
                  <Status>Available</Status>
                </div>
              ))
            }
          </article>
          <article>
            <div class="card-header"><div><h3>Available tools</h3><p>24 tools across 5 services</p></div><a>View all<Icon name="arrow-right" size={13} /></a></div>
            {
              toolServices.map((s) => (
                <div class="tool-service-row">
                  <span><Icon name={s.icon} size={15} /></span>
                  <span><b>{s.name}</b><small>{s.summary}</small></span>
                  <em>{s.confirmationNote}</em>
                </div>
              ))
            }
          </article>
        </div>

        <div class="employee-bottom-grid">
          <article class="employee-activity">
            <div class="card-header"><div><h3>Your recent confirmations</h3><p>Only you and authorized administrators can see this metadata.</p></div><a>History<Icon name="arrow-right" size={13} /></a></div>
            {
              confirmations.map((c) => (
                <div>
                  <Status tone={c.tone}>{c.status}</Status>
                  <span><b>{c.tool}</b><small>{c.time}</small></span>
                  <Icon name="chevron-right" size={14} />
                </div>
              ))
            }
          </article>
          <article class="employee-help">
            <Icon name="life-buoy" size={20} />
            <span><b>Having trouble connecting?</b><p>Run the connection check or see organization-specific troubleshooting.</p></span>
            <ConnectionCheckButton client:load />
            <a href={routes.docs}>Get help <Icon name="arrow-right" size={13} /></a>
          </article>
        </div>
      </section>
    </main>
    <footer class="employee-footer">
      <span>{account.organization.name} · Signed in as {account.user.fullName} ({account.organization.role})</span>
      <div><a>Privacy</a><a>Security</a><a>Status</a></div>
    </footer>
  </div>
</BaseLayout>

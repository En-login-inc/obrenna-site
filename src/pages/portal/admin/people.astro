---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminShell from "../../../components/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
import OrganizationMembers from "../../../components/islands/OrganizationMembers";
import { getPortalAccount } from "../../../lib/portal-account";

const account = await getPortalAccount(Astro.request);
if (!account) return Astro.redirect(`/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
if (!['owner', 'admin'].includes(account.organization.role.toLowerCase())) {
  return Astro.redirect('/portal/employee');
}
---

<BaseLayout title="People & access | Obrenna">
  <AdminShell title="People & access" eyebrow="ORGANIZATION MEMBERSHIP">
    <Fragment slot="actions">
      <button disabled title="Invitations are unavailable until invitation delivery is configured" class="button">
        <Icon name="user-plus" size={15} /> Invite people
      </button>
    </Fragment>
    <OrganizationMembers organizationId={account.organization.id} client:load />
  </AdminShell>
</BaseLayout>

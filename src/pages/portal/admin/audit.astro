---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminShell from "../../../components/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
import Status from "../../../components/Status.astro";
import { listAuditEvents, decisionFor, type AuditEventRow } from "../../../lib/api/audit";

let events: AuditEventRow[] = [];
let loadError = "";
try {
  ({ events } = await listAuditEvents());
} catch (cause) {
  loadError = cause instanceof Error ? cause.message : "Could not load the audit log";
}

function timeParts(iso: string) {
  const date = new Date(iso);
  return {
    time: date.toLocaleTimeString('en-US', { hour12: false }),
    date: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
  };
}
---

<BaseLayout title="Audit log | Obrenna">
  <AdminShell title="Audit log" eyebrow="REDACTED OPERATIONAL HISTORY">
    <Fragment slot="actions">
      <button disabled title="Audit export requires a configured control-plane connection" class="secondary-button"><Icon name="download" size={15} /> Export metadata</button>
    </Fragment>

    <div class="audit-callout">
      <Icon name="shield-check" size={18} />
      <span><b>Sensitive tool arguments are hidden by default.</b><small>This log records policy decisions and lifecycle metadata—not prompt text, private files, tool inputs or tool results.</small></span>
    </div>

    {loadError && <section class="audit-error" role="status"><strong>The audit log is unavailable.</strong><span>{loadError}</span></section>}
    {!loadError && events.length === 0 && <p class="audit-empty" role="status">No audit events have been recorded for this organization yet.</p>}

    {!loadError && events.length > 0 && (
      <div class="audit-timeline portal-card">
        {
          events.map((e) => {
            const { time, date } = timeParts(e.created_at);
            const decision = decisionFor(e);
            return (
              <div class="audit-row">
                <time>{time}<small>{date}</small></time>
                <span class={`audit-marker ${decision.tone}`}><i /></span>
                <div class="audit-event">
                  <div><Status tone={decision.tone}>{decision.label}</Status><b>{e.event_type.replaceAll("_", " ")}</b><span>by {e.actor_user_id ?? "System"}</span></div>
                  <p>{e.summary || "—"}</p>
                </div>
                <div class="audit-server"><span>{e.actor_machine_id ?? "—"}</span></div>
              </div>
            );
          })
        }
      </div>
    )}
  </AdminShell>
</BaseLayout>

<style>
  .audit-error { display:flex; flex-wrap:wrap; gap:4px 8px; padding:14px 16px; margin:0 0 18px; border:1px solid #dcaea6; border-radius:9px; background:#fdeeea; color:#6d2c20; font-size:12px; line-height:1.5; }
  .audit-error strong { font-weight:700; }
  .audit-empty { margin:0 0 18px; color:var(--muted, #687276); font-size:13px; }
</style>
---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminShell from "../../../components/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
import Status from "../../../components/Status.astro";
import { routes } from "../../../lib/routes";
import { listMcpServers } from "../../../lib/api/mcp";

const servers = await listMcpServers();
---

<BaseLayout title="MCP servers | Obrenna">
  <AdminShell title="MCP servers" eyebrow="INTERNAL TOOLS">
    <Fragment slot="actions">
      <button class="button"><Icon name="plus" size={15} /> Add MCP server</button>
    </Fragment>

    <div class="review-banner">
      <Icon name="alert-triangle" size={19} />
      <span><b>1 server requires review</b><small>A schema change was detected on Linear Workspace. Changed tools remain disabled until an administrator approves them.</small></span>
      <button>Review change <Icon name="arrow-right" size={13} /></button>
    </div>

    <div class="filter-bar">
      <div class="filter-search"><Icon name="search" size={14} /><span>Search servers or tools</span></div>
      <button><Icon name="sliders-horizontal" size={13} /> Transport: All <Icon name="chevron-down" size={13} /></button>
      <button><Icon name="users" size={13} /> Visibility: All <Icon name="chevron-down" size={13} /></button>
      <span></span>
      <button><Icon name="refresh-ccw" size={13} /> Discover tools</button>
    </div>

    <div class="mcp-grid">
      {
        servers.map((s) => (
          <article class="portal-card mcp-card">
            <div class="mcp-card-head">
              <span class={`server-mark ${s.tone}`}><Icon name="network" size={17} /></span>
              <div><h3>{s.name}</h3><p>{s.transport}</p></div>
              <Status tone={s.tone}>{s.status}</Status>
              <Icon name="more-horizontal" size={16} />
            </div>
            <div class="endpoint-line"><code>{s.endpoint}</code><Icon name="lock-keyhole" size={13} /></div>
            <div class="mcp-meta">
              <div><span>Discovered tools</span><b>{s.toolsSummary}</b></div>
              <div><span>Visibility</span><b>{s.visibility}</b></div>
              <div><span>Last discovery</span><b>{s.lastDiscoveryAgo}</b></div>
            </div>
            <div class="mcp-card-foot">
              <button>View tools <Icon name="chevron-right" size={13} /></button>
              <span><Icon name="activity" size={12} /> Connected</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="trust-warning">
      <Icon name="alert-triangle" size={18} />
      <span><b>Local executable MCP servers run as trusted software.</b><small>Obrenna does not sandbox local stdio processes. Review executables, working directories, permissions and credentials before deployment.</small></span>
      <a href={routes.docs}>Security guidance <Icon name="arrow-right" size={13} /></a>
    </div>
  </AdminShell>
</BaseLayout>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminShell from "../../../components/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
import Status from "../../../components/Status.astro";
import { listMcpServers, type McpServerRow } from "../../../lib/api/mcp";
import type { StatusTone } from "../../../lib/api/types";

let servers: McpServerRow[] = [];
let loadError = "";
try {
  servers = await listMcpServers();
} catch (cause) {
  loadError = cause instanceof Error ? cause.message : "Could not load MCP servers";
}

function serverTone(status: string): StatusTone {
  if (status === "ready") return "good";
  if (status === "degraded") return "warn";
  return "neutral";
}

function statusLabel(status: string) {
  if (status === "ready") return "Healthy";
  if (status === "degraded") return "Review required";
  if (status === "disabled") return "Disabled";
  return status;
}
---

<BaseLayout title="MCP servers | Obrenna">
  <AdminShell title="MCP servers" eyebrow="INTERNAL TOOLS">
    <Fragment slot="actions">
      <button disabled title="MCP registration requires a configured control-plane connection" class="button"><Icon name="plus" size={15} /> Add MCP server</button>
    </Fragment>

    {loadError && <section class="mcp-error" role="status"><strong>MCP servers are unavailable.</strong><span>{loadError}</span></section>}
    {!loadError && servers.length === 0 && <p class="mcp-empty" role="status">No MCP servers are registered for this organization yet.</p>}

    {
      !loadError && servers.length > 0 && (
        <div class="mcp-grid">
          {servers.map((s) => (
            <article class="portal-card mcp-card">
              <div class="mcp-card-head">
                <span class={`server-mark ${serverTone(s.status)}`}><Icon name="network" size={17} /></span>
                <div><h3>{s.display_name}</h3><p>Streamable HTTP</p></div>
                <Status tone={serverTone(s.status)}>{statusLabel(s.status)}</Status>
              </div>
              <div class="endpoint-line"><code>{s.url ?? "No endpoint"}</code></div>
              <div class="mcp-meta">
                <div><span>Discovered tools</span><b>{s.tool_count} tools</b></div>
                <div><span>Enabled</span><b>{s.enabled_tool_count}</b></div>
                <div><span>Pending review</span><b>{s.tools_pending_review}</b></div>
              </div>
              <div class="mcp-card-foot">
                <span><Icon name="activity" size={12} /> Registered {new Date(s.created_at).toLocaleDateString()}</span>
              </div>
            </article>
          ))}
        </div>
      )
    }

    <div class="trust-warning">
      <Icon name="alert-triangle" size={18} />
      <span><b>Local executable MCP servers run as trusted software.</b><small>Obrenna does not sandbox local stdio processes. Review executables, working directories, permissions and credentials before deployment.</small></span>
      <a href="/docs">Security guidance <Icon name="arrow-right" size={13} /></a>
    </div>
  </AdminShell>
</BaseLayout>

<style>
  .mcp-error { display:flex; flex-wrap:wrap; gap:4px 8px; padding:14px 16px; margin:0 0 18px; border:1px solid #dcaea6; border-radius:9px; background:#fdeeea; color:#6d2c20; font-size:12px; line-height:1.5; }
  .mcp-error strong { font-weight:700; }
  .mcp-empty { margin:0 0 18px; color:var(--muted, #687276); font-size:13px; }
</style>
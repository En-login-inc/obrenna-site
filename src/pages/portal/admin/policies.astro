---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminShell from "../../../components/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
import PolicyToolTable from "../../../components/islands/PolicyToolTable";
import { listToolPolicies, getPolicySummary, type ToolPolicyRow, type PolicySummaryRow } from "../../../lib/api/policies";

let tools: ToolPolicyRow[] = [];
let summary: PolicySummaryRow | null = null;
let loadError = "";
try {
  tools = await listToolPolicies();
  summary = await getPolicySummary();
} catch (cause) {
  loadError = cause instanceof Error ? cause.message : "Could not load tool policies";
}
---

<BaseLayout title="Tool policies | Obrenna">
  <AdminShell title="Tool policies" eyebrow="PERMISSION GOVERNANCE">
    <Fragment slot="actions">
      <button disabled title="Policy export requires a configured control plane connection" class="secondary-button"><Icon name="file-check-2" size={15} /> Export policy</button>
    </Fragment>

    {loadError && <section class="policy-error" role="status"><strong>Tool policies are unavailable.</strong><span>{loadError}</span></section>}
    {!loadError && summary && (
      <div class="policy-summary">
        <div><Icon name="shield-check" size={19} /><span><b>{summary.approvedToolCount} approved tools</b><small>New and changed tools are disabled by default.</small></span></div>
        <div><b>{summary.readCount}</b><span>Read</span></div>
        <div><b>{summary.networkCount}</b><span>Network</span></div>
        <div><b>{summary.writeCount}</b><span>Write</span></div>
        <div class="destructive"><b>{summary.destructiveCount}</b><span>Destructive</span></div>
      </div>
    )}

    {!loadError && <PolicyToolTable tools={tools} client:load />}

    <div class="policy-explainer">
      <Icon name="shield" size={18} />
      <div>
        <b>Policy is applied on the organization machine</b>
        <p>The control plane publishes a signed configuration. The local agent rejects stale revisions, invalid signatures and unapproved schema changes.</p>
      </div>
      {summary && <span>APPLIED REVISION<b>{summary.appliedRevision}</b></span>}
    </div>
  </AdminShell>
</BaseLayout>

<style>
  .policy-error { display:flex; flex-wrap:wrap; gap:4px 8px; padding:14px 16px; margin:0 0 18px; border:1px solid #dcaea6; border-radius:9px; background:#fdeeea; color:#6d2c20; font-size:12px; line-height:1.5; }
  .policy-error strong { font-weight:700; }
</style>
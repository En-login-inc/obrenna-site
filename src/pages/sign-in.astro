---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyBackground from "../components/TopologyBackground.astro";
import Logo from "../components/Logo.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Icon from "../components/Icon.astro";
import SignInForm from "../components/islands/SignInForm";
import { getAuthenticatedUser } from "../lib/portal-account";

// Desktop callback parameters continue through the normal website sign-in; after authentication,
// the site issues only a short-lived, single-use PKCE authorization code to the native callback.
const desktopCallback = Astro.url.searchParams.get('desktop_callback');
const currentUser = desktopCallback ? await getAuthenticatedUser(Astro.request) : null;
---

<BaseLayout title="Sign in | Obrenna">
  <main class="auth-page" data-desktop-callback={desktopCallback || undefined}>
    <TopologyBackground />
    <div class="auth-brand"><Logo /></div>
    <div class="auth-copy">
      <Eyebrow>ORGANIZATION-OWNED AI</Eyebrow>
      <h1>Welcome back.</h1>
      <p>Sign in to manage your organization or connect your desktop app.</p>
      <div class="auth-architecture">
        <div><Icon name="cloud-cog" /><span><b>Obrenna control plane</b><small>Identity · policy · health</small></span></div>
        <span class="auth-line"><Icon name="lock-keyhole" size={16} /></span>
        <div><Icon name="server" /><span><b>Your private infrastructure</b><small>Models · tools · company data</small></span></div>
      </div>
    </div>
    <SignInForm
      client:load
      desktopCallback={desktopCallback || undefined}
      currentUser={currentUser || undefined}
    />
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import PageHero from "../components/PageHero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Icon from "../components/Icon.astro";

const websiteData = ["Account email and name (only if you create one)", "Organization membership (optional organization mode)", "Desktop installers and checksums", "Nothing from the self-hosted server"];
const localData = ["Admin accounts and signed-in people", "Machine credentials (hashed)", "Guardrails and MCP tool policies", "Local audit log", "Prompts, files and model outputs (on employee devices; not stored by the server)", "MCP credentials and API keys", "Local model memory"];
const limitations = [
  "Local MCP executables are trusted software, not sandboxed code.",
  "Schema approval confirms what changed; it does not prove a tool is safe.",
  "VPN, endpoint security, backups and patching remain organizational duties.",
  "Administrators control retention, telemetry and MCP configuration.",
];
---

<BaseLayout title="Data privacy | Obrenna">
  <div class="public-page">
    <PublicHeader />
    <main>
      <PageHero
        eyebrow="Privacy"
        title={`A privacy promise you can <span>draw as a boundary.</span>`}
        body="The self-hosted product keeps everything on your machine. Here is exactly what lives where — and the little that can leave your network."
      >
        <div class="privacy-badges">
          <span><Icon name="shield-check" size={14} /> No prompt storage by default</span>
          <span><Icon name="lock-keyhole" size={14} /> Credentials hashed at rest</span>
          <span><Icon name="scan-line" size={14} /> Local, exportable audit log</span>
        </div>
      </PageHero>

      <section class="light-section privacy-boundary">
        <div class="container">
          <div class="section-heading split-heading">
            <div><Eyebrow>DATA RESPONSIBILITY</Eyebrow><h2>What goes where.</h2></div>
            <p>Accounts, policies and the audit log live in the server's local database. Sensitive work stays on the devices and network your organization manages.</p>
          </div>
          <div class="data-columns">
            <article class="cloud-data">
              <div class="data-title"><Icon name="cloud-cog" /><span><b>Obrenna website</b><small>Optional account &amp; downloads</small></span></div>
              <ul>{websiteData.map((x) => <li><Icon name="check" size={14} />{x}</li>)}</ul>
            </article>
            <div class="data-divider"><Icon name="shield-check" /><span>The self-hosted server sends nothing to the website</span></div>
            <article class="local-data">
              <div class="data-title"><Icon name="lock-keyhole" /><span><b>Your infrastructure</b><small>Server + employee devices</small></span></div>
              <ul>{localData.map((x) => <li><Icon name="check" size={14} />{x}</li>)}</ul>
            </article>
          </div>
        </div>
      </section>

      <section class="dark-section transmission-section">
        <div class="container">
          <div class="section-heading centered"><Eyebrow>NETWORK TRANSPARENCY</Eyebrow><h2>Know what is transmitted—and what is not.</h2></div>
          <div class="transmission-grid">
            <article>
              <span class="transmit-icon yes"><Icon name="arrow-right" /></span>
              <h3>What can leave your network</h3>
              <p>Authentication traffic to your own identity provider during company sign-in (only if enabled), optional website sign-in if you choose to use an Obrenna account, and installer downloads from this site.</p>
            </article>
            <article>
              <span class="transmit-icon no"><Icon name="x" /></span>
              <h3>Not sent by default</h3>
              <p>Prompts, chat content, documents, model outputs, MCP tool arguments, tool results, private API keys or data-store responses. The self-hosted server stores none of this and forwards none of it to Obrenna.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="light-section limitation-section">
        <div class="container limitation-grid">
          <div>
            <Eyebrow>SECURITY IS SHARED WORK</Eyebrow>
            <h2>Clear limits. No absolute claims.</h2>
            <p>Private AI can only be as secure as the systems it runs on. Obrenna provides controls; your organization remains responsible for its environment.</p>
          </div>
          <div class="limitation-list">
            {limitations.map((x) => <div><Icon name="alert-triangle" size={16} />{x}</div>)}
          </div>
        </div>
      </section>
    </main>
    <PublicFooter />
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import PageHero from "../components/PageHero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import IconBox from "../components/IconBox.astro";
import Status from "../components/Status.astro";
import { routes } from "../lib/routes";

const rows = [
  ["Prompt and output location", "Provider cloud", "Provider cloud", "Your infrastructure"],
  ["Private MCP governance", "Limited", "Build it yourself", "Built in"],
  ["Central employee access", "Built in", "Build it yourself", "Built in"],
  ["Model and hardware choice", "Limited", "Full", "Full"],
  ["Schema-change approval", "Varies", "Build it yourself", "Explicit"],
  ["Admin audit metadata", "Provider-defined", "Build it yourself", "Organization-defined"],
];

const rolloutSteps: Array<[string, string]> = [
  ["01", "One machine"],
  ["02", "One organization"],
  ["03", "Multiple employees"],
  ["04", "Multiple MCP servers"],
  ["05", "Enterprise identity"],
];

const platformFeatures: Array<[string, string, string, string[]]> = [
  ["server", "Private AI infrastructure", "Operate models on hardware and networks your organization controls.", ["Ollama, vLLM and compatible runtimes", "Multiple models and role assignments", "Health, capacity and version monitoring"]],
  ["workflow", "Governed MCP integration", "Connect internal systems without turning every employee into an infrastructure engineer.", ["Streamable HTTP and local stdio", "Automatic discovery and schema review", "Per-tool confirmation requirements"]],
  ["users", "Organization administration", "Manage identity, access and machines from one consistent control plane.", ["Owner, admin, member and auditor roles", "Secure invitations and session revocation", "Multiple environments and devices"]],
  ["laptop", "Employee-ready desktop", "Approved organization configuration arrives automatically after sign-in.", ["No CLI, Python or JSON setup", "Visible models and permitted tools", "Safe failure and clear offline states"]],
  ["shield-check", "Privacy by architecture", "The control plane handles governance while private work remains local.", ["No prompt storage by default", "Opaque credential references", "Configurable retention and telemetry"]],
  ["file-check-2", "Policy and audit", "Make agent permissions understandable, reviewable and enforceable.", ["Read, network, write and destructive risk", "Never, first-use or every-use confirmation", "Redacted decision history"]],
];
---

<BaseLayout title="Why Obrenna | Obrenna">
  <div class="public-page">
    <PublicHeader />
    <main>
      <PageHero
        eyebrow="WHY OBRENNA"
        title={`Private AI is easy to start.<br /><span>Operating it is the hard part.</span>`}
        body="Model hosting alone does not give an organization identity, policy, employee access, safe tool controls or a comprehensible operating model. Obrenna does."
      />

      <section class="light-section why-section">
        <div class="container">
          <div class="section-heading split-heading">
            <div><Eyebrow>THE MISSING LAYER</Eyebrow><h2>Control without making employees carry the complexity.</h2></div>
            <p>Your team should not need to understand model servers, MCP transport, credential files or schema manifests to use private AI responsibly.</p>
          </div>
          <div class="why-cards">
            <article><span>FOR IT</span><h3>One place to govern</h3><p>See machines, endpoints, services, roles and decisions across the organization.</p></article>
            <article><span>FOR ENGINEERING</span><h3>Open, compatible building blocks</h3><p>Use the model runtimes and MCP servers that fit your actual systems.</p></article>
            <article><span>FOR EMPLOYEES</span><h3>One app that just connects</h3><p>Sign in, choose an organization and use only what has been approved.</p></article>
          </div>
        </div>
      </section>

      <section class="comparison-section">
        <div class="container">
          <div class="section-heading centered"><Eyebrow>COMPARE THE OPERATING MODELS</Eyebrow><h2>Private execution and managed governance.</h2></div>
          <div class="comparison-table">
            <div class="comparison-row comparison-head">
              <span>Capability</span>
              <span>Public AI chat</span>
              <span>DIY self-hosting</span>
              <span class="obrenna-col"><Logo light /></span>
            </div>
            {
              rows.map((row) => (
                <div class="comparison-row">
                  {row.map((cell, i) => (
                    <span class={i === 3 ? "obrenna-col" : ""}>
                      {i === 3 && cell === "Built in" ? (
                        <>
                          <Icon name="check-circle-2" size={14} /> {cell}
                        </>
                      ) : (
                        cell
                      )}
                    </span>
                  ))}
                </div>
              ))
            }
          </div>
          <p class="comparison-note">
            <Icon name="alert-triangle" size={15} /> Obrenna improves organizational control and privacy; it does not make organization-managed infrastructure automatically secure. Endpoint security, network configuration, patching, backups and trusted executables remain your responsibility.
          </p>
        </div>
      </section>

      <section class="light-section rollout-section">
        <div class="container">
          <div><Eyebrow>GROW AT YOUR OWN PACE</Eyebrow><h2>Start with one node.<br />Keep the path to scale.</h2></div>
          <div class="rollout-track">
            {
              rolloutSteps.map(([n, label], i) => (
                <div class={i < 3 ? "complete" : ""}>
                  <b>{n}</b>
                  <span>{label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="dark-section runtime-section">
        <div class="container runtime-grid">
          <div>
            <h2>Your models. Your hardware. One governed service.</h2>
            <p>Register endpoints without exposing runtime credentials to employees or the browser.</p>
            <div class="runtime-logos">
              <span><Icon name="box" size={16} /> Ollama</span>
              <span><Icon name="zap" size={16} /> vLLM</span>
              <span><Icon name="code-2" size={16} /> Compatible API</span>
            </div>
          </div>
          <div class="runtime-spec">
            <div class="spec-head"><span>Production inference</span><Status>AVAILABLE</Status></div>
            <dl>
              <div><dt>Runtime</dt><dd>vLLM 0.9</dd></div>
              <div><dt>Model role</dt><dd>Primary reasoning</dd></div>
              <div><dt>Context limit</dt><dd>128,000 tokens</dd></div>
              <div><dt>Credential</dt><dd>secret://prod/vllm <Icon name="lock-keyhole" size={13} /></dd></div>
              <div><dt>Policy revision</dt><dd>v42 · approved</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="light-section feature-detail-section">
        <div class="container">
          <div class="feature-detail-grid">
            {
              platformFeatures.map(([icon, title, body, items], index) => (
                <article class="feature-detail-card">
                  <div class="feature-card-top">
                    <IconBox icon={icon} />
                  </div>
                  <h2>{title}</h2>
                  <p>{body}</p>
                  <ul>
                    {items.map((item) => (
                      <li><Icon name="check" size={14} />{item}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="light-section">
        <div class="container boundary-banner">
          <Icon name="shield-check" />
          <div>
            <span>THE NON-NEGOTIABLE BOUNDARY</span>
            <h2>Your prompts, files, model outputs, MCP arguments and tool results remain in your organization's environment by default.</h2>
          </div>
          <a class="button button-dark" href={routes.privacy}>Review the data model <Icon name="arrow-right" /></a>
        </div>
      </section>
    </main>
    <PublicFooter />
  </div>
</BaseLayout>

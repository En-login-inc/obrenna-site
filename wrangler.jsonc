{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obrenna-site-worker",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ENV": "production",
    "SITE_PUBLIC_ORIGIN": "https://obrenna.com"
  },
  "workers_dev": true,
  "routes": [
    {
      "zone_name": "obrenna.com",
      "pattern": "obrenna.com/*"
    }
  ]
}

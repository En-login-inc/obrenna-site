{
  "name": "obrenna-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:auth": "node --experimental-strip-types --test tests/auth-contract.test.ts tests/portal-bridge.test.ts tests/migration-runner.test.mjs tests/desktop-inference-contract.test.ts",
    "test:portal-integration": "node --experimental-strip-types --test tests/portal-integration.test.ts",
    "test:auth:migrations:postgres": "node scripts/verify-auth-migrations.mjs",
    "test:auth:desktop-postgres": "node scripts/verify-desktop-auth-flow.mjs",
    "setup:auth-db": "powershell -NoProfile -ExecutionPolicy Bypass -File ./server-db/scripts/setup-auth-db.ps1",
    "setup:auth-db:sh": "bash ./server-db/scripts/setup-auth-db.sh",
    "migrate:auth-db": "node ./scripts/migrate-auth-db.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.25.0",
    "lucide-static": "^1.25.0",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3"
  }
}

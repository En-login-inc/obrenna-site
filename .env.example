# Local app state (kept in Obrenna desktop app)
LOCAL_DB_URL=sqlite:///./data/obrenna_local.db

# Shared auth / org / billing Postgres (Dockerized local development)
AUTH_DB_URL=postgresql://obrenna:obrenna@localhost:5432/obrenna-server-db
APP_ENV=development
# Public canonical website origin used as the issuer for desktop inference grants.
SITE_PUBLIC_ORIGIN=http://localhost:4321
# Generate a private key for the website deployment; never commit its value.
# INFERENCE_GRANT_KEY_ID=obrenna-grants-2026-01
# INFERENCE_GRANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# During rotation, publish up to 16 previous public RSA JWKs as a JSON array.
# Keep each old kid here until every grant signed with it has expired (24 hours).
# INFERENCE_GRANT_PREVIOUS_PUBLIC_KEYS='[{"kid":"obrenna-grants-2025-12","kty":"RSA","n":"...","e":"AQAB"}]'
AUTH_SESSION_TTL_DAYS=30
ALLOW_BILLING_ONLY_SYNC=true
SITE_API_BASE_URL=http://localhost:4321

# Required for one-time, signed Obrenna-Server install and host-pairing JWTs.
# Generate a unique random secret of at least 32 bytes for each deployment.
INFERENCE_PAIRING_JWT_SECRET=

# Server-side credential for downloading the private Obrenna-Server repository.
# Use a fine-grained GitHub token scoped to that repository with Contents: Read only.
# Never put this token in browser code or an install command.
OBRENNA_SERVER_GITHUB_TOKEN=
OBRENNA_SERVER_GITHUB_REPOSITORY=En-login-inc/Obrenna-Server
OBRENNA_SERVER_GITHUB_REF=main
# FastAPI control plane (portal fleet/operational data)
CONTROL_PLANE_URL=http://localhost:8000
# Short-lived RS256 assertions the site server signs for portal requests.
# The matching public key must be configured on the control plane
# (OBRENNA_PORTAL_SIGNING_PUBLIC_KEY or ..._PATH).
# CONTROL_PLANE_ASSERTION_KEY_ID=obrenna-portal-2026-01
# CONTROL_PLANE_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CONTROL_PLANE_TIMEOUT_MS=10000

# Optional production overrides
# AUTH_DB_URL=postgresql://user:password@prod-db-host:5432/obrenna-server-db
# APP_ENV=production

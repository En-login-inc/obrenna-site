# Local app state (kept in Obrenna desktop app)
LOCAL_DB_URL=sqlite:///./data/obrenna_local.db

# Shared auth / org / billing Postgres (Dockerized local development)
AUTH_DB_URL=postgresql://obrenna:obrenna@localhost:5432/obrenna-server-db
APP_ENV=development
AUTH_SESSION_TTL_DAYS=30
ALLOW_BILLING_ONLY_SYNC=true
SITE_API_BASE_URL=http://localhost:4321

# Required for one-time, signed Obrenna-Server install and host-pairing JWTs.
# Generate a unique random secret of at least 32 bytes for each deployment.
INFERENCE_PAIRING_JWT_SECRET=

# Server-side credential for downloading the private Obrenna-Server repository.
# Use a fine-grained GitHub token scoped to that repository with Contents: Read only.
# Never put this token in browser code or an install command.
OBRENNA_SERVER_GITHUB_TOKEN=
OBRENNA_SERVER_GITHUB_REPOSITORY=En-login-inc/Obrenna-Server
OBRENNA_SERVER_GITHUB_REF=main

# Optional production overrides
# AUTH_DB_URL=postgresql://user:password@prod-db-host:5432/obrenna-server-db
# APP_ENV=production

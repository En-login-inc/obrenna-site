# Local app state (kept in Obrenna desktop app)
LOCAL_DB_URL=sqlite:///./data/obrenna_local.db

# Shared auth / org / billing Postgres (Dockerized local development)
AUTH_DB_URL=postgresql://obrenna:obrenna@localhost:5432/obrenna-server-db
APP_ENV=development
AUTH_SESSION_TTL_DAYS=30
ALLOW_BILLING_ONLY_SYNC=true
SITE_API_BASE_URL=http://localhost:4321

# Optional production overrides
# AUTH_DB_URL=postgresql://user:password@prod-db-host:5432/obrenna-server-db
# APP_ENV=production
